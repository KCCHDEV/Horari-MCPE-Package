  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.12",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
