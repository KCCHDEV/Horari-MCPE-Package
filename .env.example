# Runtime
PORT=3002

# MongoDB Atlas or self-hosted MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=horari_service
# บัญชีที่จะใช้หลังบ้านต้องมี users.role = "admin" ใน MongoDB
# Production: ใส่ MongoDB Atlas URI ใน environment manager เท่านั้น ห้าม commit ลง repo

# Payment gateway adapter: send a signed JSON webhook to /api/payments/webhook
PAYMENT_PROVIDER=your-gateway
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
PAYMENT_CHECKOUT_URL_TEMPLATE=https://payment.example/checkout/{orderId}
APP_URL=https://your-domain.example
PAYMENT_MODE=subscription
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Pterodactyl Application API
PTERO_URL=https://panel.example.com
PTERO_APPLICATION_TOKEN=replace-with-application-api-token
PTERO_NEST_ID=1
PTERO_EGG_ID=1
PTERO_LOCATION_ID=1
PTERO_DOCKER_IMAGE=ghcr.io/pterodactyl/yolks:java_21
PTERO_STARTUP=java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar server.jar
PTERO_VANILLA_VERSION=latest

# Optional per-service overrides. Required when services use different Eggs.
# PTERO_WEBHOSTING_EGG_ID=2
# PTERO_WEBHOSTING_DOCKER_IMAGE=ghcr.io/example/web-yolk:latest
# PTERO_WEBHOSTING_STARTUP=...
# PTERO_WEBHOSTING_ENV_JSON={"APP_ENV":"production"}
# PTERO_CODEHOSTING_EGG_ID=3
# PTERO_CODESERVER_EGG_ID=4
