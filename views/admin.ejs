<!doctype html>
<html lang="th">
<head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
    <title>หลังบ้าน | <%= settings.shopName %></title>
    <link rel="stylesheet" href="/css/styles.css?v=<%= assets.css %>">
    <style>
      .admin-shell{width:min(1180px,calc(100% - 28px));margin:28px auto 80px}.admin-top{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:22px}.admin-panel{margin-bottom:18px}.admin-table{width:100%;border-collapse:collapse}.admin-table th,.admin-table td{padding:10px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle}.admin-table input{width:100%;min-width:86px}.admin-table .wide{min-width:150px}.admin-status{font-size:12px;color:var(--muted)}@media(max-width:720px){.admin-top{align-items:flex-start;flex-direction:column}.admin-table{display:block;overflow-x:auto;white-space:nowrap}.admin-table input{width:110px}.admin-table .wide{width:150px}}
    </style>
</head>
<body>
<main class="admin-shell">
  <header class="admin-top"><div><p class="eyebrow">Admin Control Panel</p><h1>จัดการร้านค้า</h1><p class="section-lead">ตั้งราคา โปรโมชัน และข้อความ event ได้จากหน้านี้</p></div><a class="secondary-button" href="/">กลับหน้าเว็บ</a></header>
  <section class="settings-panel admin-panel">
    <h2>Event / โปรโมชันหน้าร้าน</h2>
    <form id="settingsForm" class="settings-form">
      <label><span>ชื่อ Event</span><input name="eventTitle" value="<%= settings.eventTitle || '' %>" maxlength="120"></label>
      <label><span>รายละเอียด</span><textarea name="eventDescription" rows="3"><%= settings.eventDescription || '' %></textarea></label>
      <div class="two-cols"><label><span>วันสิ้นสุด Event</span><input type="datetime-local" name="eventDate" value="<%= settings.eventDate || '' %>"></label><label><span>เปิดแสดง Event</span><select name="eventEnabled"><option value="true" <%= String(settings.eventEnabled) === 'true' ? 'selected' : '' %>>เปิด</option><option value="false" <%= String(settings.eventEnabled) !== 'true' ? 'selected' : '' %>>ปิด</option></select></label></div>
      <button class="primary-button" type="submit">บันทึก Event</button><p id="settingsMessage" class="form-message" role="status"></p>
    </form>
  </section>
  <section class="settings-panel admin-panel"><h2>แพ็กเกจและราคา</h2><p class="admin-status">ราคาที่มีผลจริงจะแสดงบนหน้าแพ็กเกจทันทีหลังบันทึก</p>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>บริการ</th><th>แพ็กเกจ</th><th>ราคาปกติ</th><th>ราคาลด</th><th>ลด %</th><th>เริ่ม</th><th>สิ้นสุด</th><th>สถานะ</th><th></th></tr></thead><tbody>
    <% packages.forEach((pkg) => { %><tr data-id="<%= pkg._id %>"><td><%= pkg.serviceType %></td><td class="wide"><input data-key="name" value="<%= pkg.name || '' %>"></td><td><input data-key="price" type="number" min="0" step="0.01" value="<%= pkg.price || 0 %>"></td><td><input data-key="salePrice" type="number" min="0" step="0.01" value="<%= pkg.salePrice ?? '' %>"></td><td><input data-key="salePercent" type="number" min="0" max="99" step="1" value="<%= pkg.salePercent ?? '' %>"></td><td><input data-key="saleStartsAt" type="datetime-local" value="<%= pkg.saleStartsAt ? String(pkg.saleStartsAt).slice(0,16) : '' %>"></td><td><input data-key="saleEndsAt" type="datetime-local" value="<%= pkg.saleEndsAt ? String(pkg.saleEndsAt).slice(0,16) : '' %>"></td><td><select data-key="active"><option value="true" <%= pkg.active !== false ? 'selected' : '' %>>แสดง</option><option value="false" <%= pkg.active === false ? 'selected' : '' %>>ซ่อน</option></select></td><td><button class="secondary-button save-package" type="button">บันทึก</button></td></tr><% }) %>
    </tbody></table></div><p id="packageMessage" class="form-message" role="status"></p>
  </section>
</main>
<script>
const settingsForm=document.getElementById('settingsForm');const settingsMessage=document.getElementById('settingsMessage');
settingsForm.addEventListener('submit',async(e)=>{e.preventDefault();const body=Object.fromEntries(new FormData(settingsForm));const r=await fetch('/api/admin/settings',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});settingsMessage.textContent=r.ok?'บันทึกแล้ว':'บันทึกไม่สำเร็จ';});
document.querySelectorAll('.save-package').forEach((button)=>button.addEventListener('click',async()=>{const row=button.closest('tr');const body={};row.querySelectorAll('[data-key]').forEach((input)=>{body[input.dataset.key]=input.type==='number'?(input.value===''?'':Number(input.value)):input.value});button.disabled=true;const r=await fetch('/api/admin/packages/'+row.dataset.id,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});button.disabled=false;document.getElementById('packageMessage').textContent=r.ok?'บันทึกราคาแล้ว':'บันทึกแพ็กเกจไม่สำเร็จ';}));
</script>
</body></html>
