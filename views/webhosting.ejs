<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= meta.title %></title>
    <meta name="description" content="<%= meta.description %>">
    <link rel="canonical" href="<%= meta.canonical %>">
    <link rel="icon" href="<%= meta.icon %>">
    <link rel="apple-touch-icon" href="<%= meta.icon %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= meta.siteName %>">
    <meta property="og:title" content="<%= meta.title %>">
    <meta property="og:description" content="<%= meta.description %>">
    <meta property="og:url" content="<%= meta.canonical %>">
    <meta property="og:image" content="<%= meta.image %>">
    <meta property="og:image:alt" content="<%= meta.siteName %> logo">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= meta.title %>">
    <meta name="twitter:description" content="<%= meta.description %>">
    <meta name="twitter:image" content="<%= meta.image %>">
    <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css?v=<%= assets.css %>">
    <style>
        :root {
            --brand: <%= settings.primaryColor %>;
            --brand-2: <%= settings.secondaryColor %>;
        }

        .billing-toggle-wrap {
            display: grid;
            gap: 12px;
            margin: -8px 0 28px;
        }

        .billing-toggle {
            display: inline-flex;
            align-self: flex-start;
            gap: 4px;
            padding: 4px;
            border: 1px solid var(--line, #dbe4f0);
            border-radius: 12px;
            background: var(--surface-strong, #fff);
        }

        .billing-option {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 42px;
            padding: 0 16px;
            border: 0;
            border-radius: 8px;
            background: transparent;
            color: var(--muted, #64748b);
            font: inherit;
            font-size: 13px;
            font-weight: 750;
            cursor: pointer;
            appearance: none;
            -webkit-appearance: none;
            white-space: nowrap;
        }

        .billing-option .iconify,
        .billing-option svg {
            flex: 0 0 auto;
            font-size: 18px;
            width: 18px;
            height: 18px;
        }

        .billing-option.active {
            background: var(--brand);
            color: #fff;
            box-shadow: 0 8px 18px color-mix(in srgb, var(--brand) 22%, transparent);
        }

        .billing-hint {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0;
            color: var(--muted, #64748b);
            font-size: 13px;
            line-height: 1.5;
        }

        .billing-hint .iconify,
        .billing-hint svg {
            flex: 0 0 auto;
            font-size: 18px;
            color: var(--brand);
        }
    </style>
</head>
<body>
    <nav class="site-nav">
        <a class="brand-lockup" href="/" aria-label="<%= settings.shopName %>">
            <span class="brand-mark">
                <% if (settings.logoUrl) { %>
                    <img src="<%= settings.logoUrl %>" alt="<%= settings.shopName %> logo">
                <% } else { %>
                    <span><%= settings.logoText %></span>
                <% } %>
            </span>
            <span>
                <strong><%= settings.shopName %></strong>
                <small><%= settings.tagline %></small>
            </span>
        </a>

        <button class="nav-toggle" type="button" aria-label="เปิดเมนู" aria-expanded="false">
            <span class="iconify" data-icon="mdi:menu"></span>
        </button>

        <div class="nav-links" aria-label="เมนูหลัก">
            <a href="/">หน้าแรก</a>
            <a href="/minecraft">Minecraft</a>
            <a href="/webhosting" class="active">WebHosting</a>
            <a href="/codehosting">CodeHosting</a>
            <a href="/codeserver">CodeServer</a>
            <a href="/servers">เซิร์ฟเวอร์</a>
            <a href="/terms">ข้อตกลง</a>
            <a href="/privacy">ความเป็นส่วนตัว</a>
            <a href="/contact">ติดต่อ</a>
        </div>

        <a class="nav-action" href="/contact">
            <span class="iconify" data-icon="mdi:message-text-outline"></span>
            <span><%= settings.contactLabel %></span>
        </a>
    </nav>

    <main>
        <section class="hero-section reveal">
            <div class="hero-particles" aria-hidden="true">
                <div class="hero-particle"></div>
                <div class="hero-particle"></div>
                <div class="hero-particle"></div>
                <div class="hero-particle"></div>
                <div class="hero-particle"></div>
            </div>
            <div class="hero-copy">
                <p class="eyebrow hero-entry hero-entry-1">Web Hosting</p>
                <h1 class="hero-entry hero-entry-2"><span class="hero-highlight">Web Hosting</span> <span class="typewriter-inline"><span id="typewriterText" data-typewriter='["PHP/HTML สำหรับคุณ","พร้อม MySQL Database","SSL ฟรีทุกแพ็กเกจ","PHP 8.x"]'>PHP/HTML สำหรับคุณ</span><span class="typewriter-cursor"></span></span></h1>
                <p class="hero-subtitle hero-entry hero-entry-3">บริการเช่า Web Hosting ที่พร้อมให้คุณอัปโหลดเว็บไซต์ PHP หรือ HTML ได้ทันที รองรับ MySQL พื้นที่จัดเก็บและแบนด์วิดท์ครบถ้วน สำหรับทั้งเว็บส่วนตัวและธุรกิจ</p>

                <div class="hero-actions hero-entry hero-entry-4">
                    <a class="primary-button" href="#packages">
                        <span class="iconify" data-icon="mdi:web"></span>
                        <span>ดูแพ็กเกจ WebHosting</span>
                    </a>
                    <a class="secondary-button" href="/contact">
                        <span class="iconify" data-icon="mdi:message-text-outline"></span>
                        <span>ปรึกษาก่อนสั่งซื้อ</span>
                    </a>
                </div>
            </div>

        </section>

        <section class="feature-strip reveal reveal-delay-1" id="features">
            <div class="feature-entry feature-entry-1">
                <span class="iconify" data-icon="mdi:language-php"></span>
                <strong>รองรับ PHP และ HTML</strong>
                <p>อัปโหลดไฟล์ PHP หรือ HTML ของคุณได้ทันที รองรับ PHP 8.x พร้อม extensions ที่จำเป็นสำหรับเว็บไซต์สมัยใหม่</p>
            </div>
            <div class="feature-entry feature-entry-2">
                <span class="iconify" data-icon="mdi:database-outline"></span>
                <strong>MySQL Database ในตัว</strong>
                <p>แต่ละแพ็กเกจมาพร้อมฐานข้อมูล MySQL ตามจำนวนที่กำหนด จัดการผ่าน phpMyAdmin ได้สะดวก</p>
            </div>
            <div class="feature-entry feature-entry-3">
                <span class="iconify" data-icon="mdi:domain"></span>
                <strong>รองรับหลายโดเมน</strong>
                <p>ผูกโดเมนได้หลายเว็บไซต์ในบัญชีเดียว พร้อม SSL และ DNS management สำหรับแต่ละโดเมน</p>
            </div>
        </section>

        <% if (settings.eventEnabled === 'true' && settings.eventDate) { %>
            <section class="event-countdown reveal reveal-delay-2" id="event" data-countdown-date="<%= settings.eventDate %>">
                <div class="event-copy">
                    <p class="eyebrow">Event Countdown</p>
                    <h2><%= settings.eventTitle %></h2>
                    <p><%= settings.eventDescription %></p>
                </div>
                <div class="countdown-wrap" aria-label="เวลานับถอยหลังอีเวนต์">
                    <div class="countdown-item">
                        <strong data-countdown-days>00</strong>
                        <span>วัน</span>
                    </div>
                    <div class="countdown-item">
                        <strong data-countdown-hours>00</strong>
                        <span>ชั่วโมง</span>
                    </div>
                    <div class="countdown-item">
                        <strong data-countdown-minutes>00</strong>
                        <span>นาที</span>
                    </div>
                    <div class="countdown-item">
                        <strong data-countdown-seconds>00</strong>
                        <span>วินาที</span>
                    </div>
                </div>
                <a class="primary-button event-button" href="<%= settings.eventButtonUrl %>">
                    <span class="iconify" data-icon="mdi:calendar-star"></span>
                    <span><%= settings.eventButtonLabel %></span>
                </a>
            </section>
        <% } %>

        <section class="package-section reveal reveal-delay-2" id="packages">
            <div class="section-heading">
                <p>แพ็กเกจ Web Hosting</p>
                <h2>เลือกแพ็กเกจตามขนาดเว็บไซต์ของคุณ</h2>
            </div>

            <div class="pkg-filter-bar">
                <span class="iconify" data-icon="mdi:filter-variant"></span>
                <div class="pkg-filter-group">
                    <label for="filterStorage">Storage</label>
                    <select class="pkg-filter-select" id="filterStorage" data-filter="Storage">
                        <option value="">ทั้งหมด</option>
                        <option value="1 GB">1 GB</option>
                        <option value="5 GB">5 GB</option>
                        <option value="10 GB">10 GB</option>
                        <option value="20 GB">20 GB</option>
                        <option value="50 GB">50 GB</option>
                    </select>
                </div>
                <div class="pkg-filter-group">
                    <label for="filterPriceWH">ราคา</label>
                    <select class="pkg-filter-select" id="filterPriceWH" data-filter="price">
                        <option value="">ทั้งหมด</option>
                        <option value="0-100">≤ ฿100</option>
                        <option value="100-300">฿100 - ฿300</option>
                        <option value="300-99999">≥ ฿300</option>
                    </select>
                </div>
                <button class="pkg-filter-clear" type="button">
                    <span class="iconify" data-icon="mdi:close"></span>
                    ล้าง
                </button>
                <span class="pkg-filter-count"></span>
            </div>

            <div class="billing-toggle-wrap">
                <div class="billing-toggle" role="group" aria-label="เลือกรอบบิล">
                    <button type="button" class="billing-option active" data-billing="monthly" aria-pressed="true">
                        <span class="iconify" data-icon="mdi:calendar-month-outline"></span>
                        <span>รายเดือน</span>
                    </button>
                    <button type="button" class="billing-option" data-billing="daily" aria-pressed="false">
                        <span class="iconify" data-icon="mdi:calendar-today-outline"></span>
                        <span>รายวัน</span>
                    </button>
                </div>
                <p class="billing-hint" id="billingHint">
                    <span class="iconify" data-icon="mdi:tag-heart-outline"></span>
                    <span id="billingHintText">รายเดือนถูกกว่ารายวัน — เหมาะสำหรับใช้งานต่อเนื่อง</span>
                        </p>
                        </div>
                    </div>
                </div>

            <div class="package-groups">
                <% Object.entries(packageGroups).forEach(([tier, groupPackages], index) => { %>
                    <section class="package-group">
                        <div class="group-heading">
                            <div>
                                <p>ระดับที่ <%= index + 1 %></p>
                                <h3><%= tier %></h3>
                            </div>
                            <span><%= groupPackages.length %> แพ็กเกจ</span>
                        </div>

                        <div class="package-grid">
                            <% groupPackages.forEach((pkg, pkgIndex) => {
                                const packageKey = `${tier}-${pkg.id}`;
                                const specMap = Object.fromEntries((pkg.specs || []).map((spec) => [spec.label, spec.value]));
                            %>
                                <article class="pkg-card fade-in delay-<%= pkgIndex + 1 %> <%= pkg.defaultSelected ? 'selected' : '' %>" data-package="<%= packageKey %>" data-select-package>
                                    <% if (pkg.popular) { %>
                                        <div class="popular-badge">ยอดนิยม</div>
                                    <% } %>
                                    <div class="pkg-top">
                                        <div class="mc-icon" style="background:<%= pkg.iconBg %>;">
                                            <img class="pkg-img" src="<%= pkg.image %>" alt="<%= pkg.name %>">
                                        </div>
                                        <div>
                                            <h4><%= pkg.name %></h4>
                                            <p><%= pkg.subtitle %></p>
                                        </div>
                                    </div>

                                    <div class="price-line">
                                        <span>฿</span>
                                        <strong class="price-value" data-price-display><%= pkg.price %></strong>
                                        <small class="price-period" data-price-period>/เดือน</small>
                                    </div>
                                    <p class="price-savings" data-price-savings hidden></p>

                                    <div class="spec-list">
                                        <% (pkg.specs || []).filter(s => s.label !== 'CPU Model').forEach((spec) => { %>
                                            <div class="spec-row">
                                                <span><%= spec.label %></span>
                                                <span class="spec-value"><%= spec.value %></span>
                                            </div>
                                        <% }); %>
                                    </div>

                                    <button
                                        class="btn-cta <%= pkg.defaultSelected ? 'btn-cta-orange' : '' %>"
                                        data-package-type="webhosting"
                                        data-package-id="<%= packageKey %>"
                                        data-package-name="<%= pkg.name %>"
                                        data-package-monthly-price="<%= pkg.price %>"
                                        data-package-price="<%= pkg.price %>"
                                        data-package-tier="<%= tier %>"
                                        data-package-storage="<%= specMap.Storage || '-' %>"
                                        data-package-bandwidth="<%= specMap.Bandwidth || '-' %>"
                                        data-package-domains="<%= specMap.Domains || '-' %>"
                                        data-package-php="<%= specMap['PHP/HTML'] || '-' %>"
                                        data-package-database="<%= specMap.Database || '-' %>"
                                        data-package-email="<%= specMap.Email || '-' %>"
                                        data-package-specs='<%- JSON.stringify(pkg.specs) %>'
                                        data-order-package
                                    ><%= pkg.buttonText %></button>
                                </article>
                            <% }); %>
                        </div>
                    </section>
                <% }); %>
            </div>
        </section>

        <section class="faq-section reveal reveal-delay-3" id="faq">
            <div class="section-heading">
                <p>ข้อมูลก่อนสั่งซื้อ</p>
                <h2>คำถามที่พบบ่อย — Web Hosting</h2>
            </div>
            <div class="faq-grid">
                <div class="faq-item">
                    <button class="faq-question" type="button" aria-expanded="false">
                        <span>อัปโหลดไฟล์อย่างไร?</span>
                        <span class="iconify" data-icon="mdi:chevron-down"></span>
                    </button>
                    <div class="faq-answer">
                        <div class="faq-answer-inner">
                            <p>เรามีให้คุณอัปโหลดผ่าน File Manager ใน cPanel หรือใช้ FTP/SFTP ก็ได้ Username และ password สำหรับเชื่อมต่อจะได้รับหลังจากเปิดบริการ</p>
                        </div>
                    </div>
                </div>
                <div class="faq-item">
                    <button class="faq-question" type="button" aria-expanded="false">
                        <span>รองรับ PHP เวอร์ชันไหนบ้าง?</span>
                        <span class="iconify" data-icon="mdi:chevron-down"></span>
                    </button>
                    <div class="faq-answer">
                        <div class="faq-answer-inner">
                            <p>รองรับ PHP 8.x ทุกรุ่นย่อย สามารถเลือก switch เวอร์ชันได้ผ่าน control panel ตามความต้องการของเว็บไซต์</p>
                        </div>
                    </div>
                </div>
                <div class="faq-item">
                    <button class="faq-question" type="button" aria-expanded="false">
                        <span>มี SSL ให้ไหม?</span>
                        <span class="iconify" data-icon="mdi:chevron-down"></span>
                    </button>
                    <div class="faq-answer">
                        <div class="faq-answer-inner">
                            <p>ฟรี SSL Certificate (Let's Encrypt) สำหรับทุกแพ็กเกจ สามารถติดตั้งได้ด้วยตัวเองผ่าน control panel</p>
                        </div>
                    </div>
                </div>
                <div class="faq-item">
                    <button class="faq-question" type="button" aria-expanded="false">
                        <span>ใช้หลายโดเมนในบัญชีเดียวได้ไหม?</span>
                        <span class="iconify" data-icon="mdi:chevron-down"></span>
                    </button>
                    <div class="faq-answer">
                        <div class="faq-answer-inner">
                            <p>ได้ แต่ละแพ็กเกจรองรับจำนวนโดเมนตามที่ระบุ โดยแต่ละโดเมนมีโฟลเดอร์และฐานข้อมูลแยกกัน</p>
                        </div>
                    </div>
                </div>
                <div class="faq-item">
                    <button class="faq-question" type="button" aria-expanded="false">
                        <span>ย้ายเว็บไซต์จากโฮสต์อื่นมาได้ไหม?</span>
                        <span class="iconify" data-icon="mdi:chevron-down"></span>
                    </button>
                    <div class="faq-answer">
                        <div class="faq-answer-inner">
                            <p>ได้ ทีมงานช่วยย้ายไฟล์และฐานข้อมูลให้ฟรี สำหรับแพ็กเกจ Business ขึ้นไป</p>
                        </div>
                    </div>
                </div>
                <div class="faq-item">
                    <button class="faq-question" type="button" aria-expanded="false">
                        <span>มีระบบสำรองข้อมูลให้ไหม?</span>
                        <span class="iconify" data-icon="mdi:chevron-down"></span>
                    </button>
                    <div class="faq-answer">
                        <div class="faq-answer-inner">
                            <p>มีการสำรองข้อมูลอัตโนมัติรายสัปดาห์สำหรับทุกแพ็กเกจ Business ขึ้นไปได้รับการสำรองรายวัน</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <div>
            <strong><%= settings.shopName %></strong>
            <span><%= settings.footerText %></span>
        </div>
        <nav>
            <a href="/">หน้าแรก</a>
            <a href="/minecraft">Minecraft</a>
            <a href="/webhosting">WebHosting</a>
            <a href="/codehosting">CodeHosting</a>
            <a href="/codeserver">CodeServer</a>
            <a href="/terms">ข้อตกลง</a>
            <a href="/privacy">ความเป็นส่วนตัว</a>
            <a href="/contact">ติดต่อ</a>
        </nav>
    </footer>

    <button class="back-to-top" type="button" aria-label="กลับด้านบน">
        <span class="iconify" data-icon="mdi:chevron-up"></span>
    </button>

    <div class="toast" id="toast">
        <span class="iconify" data-icon="mdi:check-circle"></span>
        <span id="toastMessage"></span>
    </div>

    <div class="order-modal" id="orderModal" aria-hidden="true">
        <div class="order-modal-backdrop" data-order-close></div>
        <section class="order-dialog" role="dialog" aria-modal="true" aria-labelledby="orderModalTitle">
            <button class="modal-close" type="button" data-order-close aria-label="ปิด">
                <span class="iconify" data-icon="mdi:close"></span>
            </button>

            <div class="order-dialog-header">
                <p class="eyebrow">เริ่มสั่งซื้อ</p>
                <h2 id="orderModalTitle">เลือกช่องทางติดต่อ</h2>
                <p id="orderPackageSummary">เลือกแพ็กเกจแล้ว กรุณาเลือกช่องทางที่สะดวก</p>
            </div>

            <div class="order-channel-grid">
                <button class="channel-card" type="button" id="chooseDiscordButton">
                    <span class="iconify" data-icon="mdi:discord"></span>
                    <strong>Discord</strong>
                    <small>เลือก Discord ที่ต้องการ แล้ว copy ข้อความไปวางเพื่อเริ่มสั่งซื้อ</small>
                </button>
                <a class="channel-card" href="/contact">
                    <span class="iconify" data-icon="mdi:message-text-outline"></span>
                    <strong>ช่องทางอื่น</strong>
                    <small>ไปหน้าติดต่อเพื่อเลือก LINE, ticket, support หรือช่องทางอื่นของร้าน</small>
                </a>
            </div>

            <div class="discord-order-panel" id="discordOrderPanel" hidden>
                <div>
                    <h3>เลือก Discord</h3>
                    <div class="discord-list" id="discordList"></div>
                </div>

                <div>
                    <div class="message-heading">
                        <h3>ข้อความสำหรับส่งใน Discord</h3>
                        <button class="copy-button" type="button" id="copyOrderMessage">
                            <span class="iconify" data-icon="mdi:content-copy"></span>
                            <span>Copy</span>
                        </button>
                    </div>
                    <textarea class="order-message-box" id="orderMessageBox" rows="11" readonly></textarea>
                </div>
            </div>
        </section>
    </div>

    <script type="application/json" id="discordContactsData"><%- JSON.stringify(settings.discordContacts || []) %></script>

    <script src="/js/app.js?v=<%= assets.js %>"></script>
</body>
</html>
